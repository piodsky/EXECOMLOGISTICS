# Copy this file to .env and adjust the values for your machine.

APP_NAME="EXECOM Logistics"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/EXECOMLOGISTICS
APP_TIMEZONE=Asia/Manila
APP_CURRENCY=₱

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=execomlogistics_db
# tools\setup-db-users.ps1 creates the restricted app user execom_app and writes it here.
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

SESSION_NAME=EXECOM_SID
# Auto-logout in seconds. 0 = never (stay signed in until Logout / browser closed)
SESSION_IDLE_TIMEOUT=0
SESSION_ABSOLUTE_TIMEOUT=0

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Go-live over the internet / VPN with a certificate: redirect http -> https + HSTS.
FORCE_HTTPS=false

# Backups (tools\backup.ps1; tools\setup-db-users.ps1 creates execom_backup and fills these in)
BACKUP_DB_USER=
BACKUP_DB_PASS=
BACKUP_DIR=C:\EXECOM-Backups
BACKUP_KEEP_DAYS=30

# tests\e2e-smoke.ps1 only: admin account that may create / drop the test database (default root, no password)
# E2E_DB_USER=root
# E2E_DB_PASS=
